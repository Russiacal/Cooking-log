# Bearer token that Claude (and any other client) must present in the
# Authorization header. Generate a strong random value; keep this secret.
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
MCP_BEARER_TOKEN=change-me-to-a-long-random-string

# Base URL that publish_cook returns to the caller.
#   Local dev:  http://localhost:4321
#   Production: https://julia-cooks.vercel.app
SITE_URL=http://localhost:4321

# ─────────────────────────────────────────────────────────
# STORAGE — set ONE of the two modes below.
# ─────────────────────────────────────────────────────────

# Mode A — LOCAL FILE (dev): writes markdown into a local Astro content dir.
# Astro's file watcher hot-reloads. Set this and leave GITHUB_* unset.
COOKS_DIR=/Users/juliakozitsyna/my-agents/cooking-log/blog/src/content/cooks

# Mode B — GITHUB API (prod): commits markdown to a GitHub repo; Vercel auto-
# deploys on push. Set these THREE (GITHUB_TOKEN + GITHUB_REPO required;
# GITHUB_BRANCH and GITHUB_COOKS_PATH have sensible defaults).
#
# GITHUB_TOKEN: fine-grained PAT, scoped to `juliakozitsyna/julia-cooks` only,
#   with `Contents: Read and write` permission. Rotate freely.
# GITHUB_REPO: "juliakozitsyna/julia-cooks"
# GITHUB_BRANCH: default "main"
# GITHUB_COOKS_PATH: default "src/content/cooks" (where .md files live in the repo)
#
# GITHUB_TOKEN=github_pat_XXX
# GITHUB_REPO=juliakozitsyna/julia-cooks
# GITHUB_BRANCH=main
# GITHUB_COOKS_PATH=src/content/cooks

# ─────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────

# Port the MCP server listens on. Railway sets $PORT automatically in prod.
PORT=8765

# Host to bind. 0.0.0.0 works for both local and prod; 127.0.0.1 restricts
# to loopback only.
HOST=0.0.0.0

# Timezone for "today" when made_on isn't supplied. Defaults to LA.
TZ=America/Los_Angeles
